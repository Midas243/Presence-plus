@layouts.app({ title: 'Accueil' })
  @page({
    title: `Bonjour ${user.fullName ?? user.email}`,
    description: `${user.promotion ?? ''}${user.option ? ' · ' + user.option : ''}`,
  })
    <div x-data="{ open: false }">
      <div class="panel" style="margin-bottom: 24px;">
        <p style="margin: 0 0 14px;">
          Pour marquer ta présence, montre ton code QR au CP : il le scanne avec son téléphone.
        </p>
        <button type="button" class="btn btn--primary btn--block" x-on:click="open = true">
          @svg('lucide:qr-code', { width: 20, height: 20 })
          Afficher mon code QR
        </button>
      </div>

      {{-- Plein écran, fond blanc : plus facile à scanner --}}
      <div
        x-show="open"
        x-cloak
        x-on:keydown.escape.window="open = false"
        style="position: fixed; inset: 0; z-index: 100; background: #fff; color: #111; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; overflow-y: auto;"
      >
        <p style="margin: 0; font-weight: 700; font-size: 20px;">{{ user.fullName ?? user.email }}</p>
        <p style="margin: 4px 0 16px; color: #555;">
          {{ user.promotion ?? '' }}{{ user.option ? ' · ' + user.option : '' }}
        </p>
        <img
          src="{{ qrCode }}"
          alt="Mon code QR de présence"
          style="width: 100%; max-width: 320px; height: auto;"
        />
        <p style="margin: 16px 0 2px; color: #555;">Ton code de validation</p>
        <p style="margin: 0; font-family: monospace; font-size: 34px; font-weight: 700; letter-spacing: 0.18em;">
          {{ user.attendanceCode }}
        </p>
        <button type="button" class="btn btn--secondary" style="margin-top: 24px;" x-on:click="open = false">
          Fermer
        </button>
      </div>
    </div>

    <h2 class="section__title" style="margin-bottom: 12px;">Mes présences</h2>
    @if(attendances.length === 0)
      <p>Aucune présence enregistrée pour le moment.</p>
    @else
      <div style="display: grid; gap: 10px;">
        @each(item in attendances)
          <div class="panel" style="padding: 14px 18px;">
            <strong>{{ item.course }}</strong>
            <div>{{ item.day }} · {{ item.hour }}</div>
            <div class="tag" style="margin-top: 6px;">Présent · {{ item.scannedAt }}</div>
          </div>
        @end
      </div>
    @end
  @end
@end
