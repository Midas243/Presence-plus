@layouts.cp({ title: classSession.course })
  @page({
    title: classSession.course,
    description: `${classSession.day} · ${classSession.hour} · ${classSession.promotion}${classSession.option ? ' · ' + classSession.option : ''}`,
  })
    <div
      x-data="attendanceScanner"
      data-present="{{ presentJson }}"
      data-absent="{{ absentJson }}"
      data-closed="{{ expired ? 'true' : 'false' }}"
      style="max-width: 520px;"
    >
      {{-- Résultat du dernier scan --}}
      <div
        x-show="feedback"
        x-cloak
        role="status"
        x-bind:style="'background:' + feedbackColor()"
        style="padding: 14px 16px; border-radius: 12px; margin-bottom: 14px; font-weight: 600;"
      >
        <span x-text="feedback ? feedback.message : ''"></span>
      </div>

      @if(expired)
        <div class="panel" style="margin-bottom: 16px;">
          <strong>Cette session est clôturée</strong> (valide jusqu’au {{ expiresAt }}). Tu peux encore consulter les listes.
        </div>
      @else
        <div class="panel" style="margin-bottom: 20px;">
          <p style="margin: 0 0 12px;">Scanne le QR Code de chaque étudiant, ou tape son code.</p>

          {{-- Méthode 1 : caméra --}}
          <button
            type="button"
            class="btn btn--primary btn--block"
            x-show="!cameraOn"
            x-on:click="startCamera()"
          >
            @svg('lucide:scan-line', { width: 18, height: 18 })
            Scanner avec la caméra
          </button>
          <div x-show="cameraOn" x-cloak>
            <video
              x-ref="video"
              playsinline
              muted
              style="width: 100%; border-radius: 12px; background: #000; max-height: 340px; object-fit: cover;"
            ></video>
            <canvas x-ref="canvas" hidden></canvas>
            <button type="button" class="btn btn--secondary btn--block" style="margin-top: 10px;" x-on:click="stopCamera()">
              Arrêter la caméra
            </button>
          </div>
          <p x-show="cameraError" x-cloak x-text="cameraError" style="margin: 10px 0 0; color: #d33;"></p>

          <hr style="margin: 18px 0; border: 0; border-top: 1px solid var(--line);" />

          {{-- Méthode 2 : code de validation tapé --}}
          @form({
            route: 'cp.sessions.attendances.store',
            routeParams: { id: classSession.id },
            method: 'POST',
            'x-ref': 'form',
            'x-on:submit.prevent': 'submitManual()',
          })
            @field.root({ name: 'code' })
              @!field.label({ text: 'Code de l’étudiant' })
              @!input.control({
                'x-model': 'code',
                autocomplete: 'off',
                autocapitalize: 'characters',
                spellcheck: 'false',
                placeholder: 'Ex : 7K3M9Q',
                style: 'text-transform: uppercase; letter-spacing: 0.12em;',
              })
            @end
            <button
              type="submit"
              class="btn btn--secondary btn--block"
              style="margin-top: 10px;"
              x-bind:disabled="busy || code.trim() === ''"
            >
              Valider le code
            </button>
          @end
        </div>
      @end

      <div style="display: flex; align-items: center; justify-content: space-between; margin: 24px 0 12px;">
        <h2 class="section__title" style="margin: 0;">
          Présents (<span x-text="present.length">0</span>)
        </h2>
        <div style="display: flex; gap: 8px;">
          <a
            href="{{ urlFor('cp.sessions.export', { id: classSession.id }) }}"
            class="btn btn--secondary btn--sm"
          >
            @svg('lucide:download', { width: 15, height: 15 })
            Exporter en Excel
          </a>
          <a href="" class="btn btn--secondary btn--sm">Actualiser</a>
        </div>
      </div>
      <p x-show="present.length === 0" x-cloak>Personne n’a encore été scanné.</p>
      <div style="display: grid; gap: 8px;">
        <template x-for="student in present" x-bind:key="student.id">
          <div class="panel" style="padding: 12px 16px; display: flex; justify-content: space-between; gap: 12px;">
            <span x-text="student.name"></span>
            <span class="tag" x-text="student.time"></span>
          </div>
        </template>
      </div>

      <h2 class="section__title" style="margin: 28px 0 12px;">
        Absents (<span x-text="absent.length">0</span>)
      </h2>
      <p x-show="absent.length === 0" x-cloak>Tous les étudiants inscrits de cette promotion sont présents.</p>
      <div style="display: grid; gap: 8px;">
        <template x-for="student in absent" x-bind:key="student.id">
          <div class="panel" style="padding: 12px 16px;" x-text="student.name"></div>
        </template>
      </div>

      <div style="margin-top: 24px;">
        @link({ route: 'cp.dashboard', class: 'btn btn--secondary' })
          Retour aux sessions
        @end
      </div>
    </div>
  @end
@end
