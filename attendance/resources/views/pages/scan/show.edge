@layouts.app({ title: 'Présence' })
  @page({ title: 'Marquer ma présence' })
    <div class="panel" style="max-width: 460px;">
      @if(classSession)
        <h2 style="margin: 0 0 6px;">{{ classSession.course }}</h2>
        <p style="margin: 0 0 16px;">
          {{ classSession.day }} · {{ classSession.hour }} · {{ classSession.promotion }}{{ classSession.option ? ' · ' + classSession.option : '' }}
        </p>
      @end

      @if(status === 'ok')
        <p>Confirme que tu es bien présent(e) à ce cours.</p>
        @form({
          route: 'scan.store',
          routeParams: { token: classSession.qrToken },
          method: 'POST',
          'x-data': '{ submitting: false }',
          'x-on:submit': 'submitting = true',
        })
          @!button({
            text: 'Confirmer ma présence',
            type: 'submit',
            block: true,
            'x-bind:disabled': 'submitting',
            'x-text': "submitting ? 'Un instant…' : 'Confirmer ma présence'",
          })
        @end
      @else
        <p><strong>{{ message }}</strong></p>
        <div style="margin-top: 16px;">
          @link({ route: 'dashboard', class: 'btn btn--secondary' })
            Retour à l’accueil
          @end
        </div>
      @end
    </div>
  @end
@end
