@layouts.auth()
  <h1 class="auth__title">Crée ton compte</h1>
  <p class="auth__sub">Inscris-toi pour marquer ta présence aux cours.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form auth__form--signup',
    'x-data': "{ submitting: false, promotion: '' }",
    'x-init': "promotion = $el.elements['promotion'].value",
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Noms complets' })
      @!input.control({ autocomplete: 'name', placeholder: 'TEPA TOKO GEORGES' })
      @!field.error()
    @end

    @field.root({ name: 'promotion' })
      @!field.label({ text: 'Promotion' })
      @!select.control({
        class: 'field__input',
        'x-on:change': 'promotion = $event.target.value',
        options: promotionOptions,
      })
      @!field.error()
    @end

    {{-- Affiché uniquement pour une promotion de Master --}}
    <div x-show="promotion.startsWith('Master')" x-cloak>
      @field.root({ name: 'option' })
        @!field.label({ text: 'Option' })
        @!select.control({
          class: 'field__input',
          'x-bind:disabled': "!promotion.startsWith('Master')",
          options: optionOptions,
        })
        @!field.error()
      @end
    </div>

    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'toi@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirme le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Créer mon compte',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Créer mon compte'",
    })
  @end

  <p class="auth__foot">
    Tu as déjà un compte ?
    @link({ route: 'session.create', class: 'il' })
      Connecte-toi
    @end
  </p>
@end
