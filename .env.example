# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Neon : copiez ici l'URL « poolée » (le nom d'hôte contient -pooler)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Facultative : URL directe, utilisée pour les migrations (déduite de DATABASE_URL si absente)
# DATABASE_URL_UNPOOLED=